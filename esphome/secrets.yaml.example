# secrets.yaml — copy this file to secrets.yaml and fill in your values.
# Never commit secrets.yaml to git.

wifi_ssid: "YourNetworkName"
wifi_password: "YourWifiPassword"

# Generate with: esphome generate-encryption-key
api_encryption_key: "paste-generated-key-here"

# Choose any random string
ota_password: "choose-a-strong-password"
fallback_hotspot_password: "choose-a-strong-password"
